<body><header><h1>Data centres in the FORSEE press corpus</h1><p>France + Ireland · 2022–June 2025</p></header>
<main><details class="notice"><summary>About this explorer</summary><div>__MODE_NOTICE__</div><p>A data-centre article contains at least one matching term. A theme is “nearby” when one of its dictionary terms falls within 500 characters of a data-centre mention. Each article counts once per theme; categories can overlap.</p></details>
<nav class="section-links" aria-label="Explorer sections"><a href="#dendrograms">IRaMuTeQ classes ↓</a><a href="#actorSection">Actors and networks ↓</a><a href="#resultTitle">Articles ↓</a></nav>
<section class="controls" aria-label="Article filters">
<div class="filter-label">Country<details class="multi-filter" id="countryFilter"><summary id="countrySummary">Both countries</summary><div class="source-menu" id="countryMenu"></div><div class="source-actions"><button type="button" data-select-all="country">Select all</button><button type="button" data-clear-all="country">Clear all</button></div></details></div>
<div class="filter-label">Corpus language<details class="multi-filter" id="languageFilter" title="Language assigned from the source corpus; not automatic language detection"><summary id="languageSummary">All languages</summary><div class="source-menu" id="languageMenu"></div><div class="source-actions"><button type="button" data-select-all="language">Select all</button><button type="button" data-clear-all="language">Clear all</button></div></details></div>
<div class="filter-label">Year<details class="multi-filter" id="yearFilter"><summary id="yearSummary">All years</summary><div class="source-menu" id="yearMenu"></div><div class="source-actions"><button type="button" data-select-all="year">Select all</button><button type="button" data-clear-all="year">Clear all</button></div></details></div>
<div class="filter-label">Newspapers<details class="multi-filter" id="sourceFilter"><summary id="sourceSummary">All newspapers</summary><div class="source-menu" id="sourceMenu"></div><div class="source-actions"><button type="button" data-select-all="source">Select all</button><button type="button" data-clear-all="source">Clear all</button></div></details></div>
<div class="filter-label">Nearby theme<details class="multi-filter" id="themeFilter"><summary id="themeSummary">Any theme</summary><div class="source-menu" id="themeMenu"></div><div class="source-actions"><button type="button" data-select-all="theme">Select all</button><button type="button" data-clear-all="theme">Clear all</button></div></details></div>
<label>Search mode<select id="searchMode"><option value="boolean" selected>Boolean / advanced</option><option value="simple">Simple phrase</option></select></label>
<label class="search-label">Search<input id="query" type="search" placeholder="data centre OR centre de données"></label>
</section>
<details class="page-help search-help" id="searchHelp"><summary>Search help</summary><div><span id="searchScope">Boolean mode searches the <strong>whole article</strong> in this team copy.</span> Use uppercase <strong>AND</strong>, <strong>OR</strong>, <strong>NOT</strong>, parentheses and quoted phrases. A multiword term is treated as a phrase. Accents and case are ignored; plural forms still need separate terms. <strong>AND</strong> requires all terms in one article; use <strong>OR</strong> for spelling or language alternatives.<br><button type="button" data-example="data center OR data centre OR centre de données OR centres de données">Any data-centre spelling</button><button type="button" data-example="data center AND data centre AND centre de données">All three in one article</button></div></details>
<div class="search-error hide" id="searchError" role="alert"></div>
<section class="stats" id="stats">__INITIAL_STATS__</section>
<section class="charts"><div class="card"><div class="chart-title">Articles by year</div><div id="years">__INITIAL_YEARS__</div></div><div class="card"><div class="chart-title">Nearby themes</div><div id="themes">__INITIAL_THEMES__</div></div></section>
<section id="themeDetails" class="card hide" aria-live="polite"></section>
<section class="card"><div class="chart-title" title="Counts and percentages are based on articles matching the current filters.">Distribution by newspaper</div><div id="newspapers">__INITIAL_NEWSPAPERS__</div></section>

__DENDROGRAM_SECTION__

<section id="actorSection" aria-labelledby="actorTitle">
<h2 id="actorTitle">Actors and co-mentions</h2>
<details class="page-help"><summary>About actor analysis</summary><p>Explore named people and organisations with French/English entity recognition and an editable actor dictionary. All filters above apply here. A connection means actors were mentioned together; it does not establish cooperation, influence, agreement or a speaking role.</p><p class="small" id="actorPublicNote">The initial view uses dictionary identities. Include unreviewed NER candidates to discover additional actors; model errors and unresolved names remain. Generic references such as “the government” are not resolved automatically.</p></details>
<div class="actor-controls">
<div class="filter-label">How close should actor mentions be?<details class="multi-filter" id="actorScopeFilter"><summary id="actorScopeSummary">Both scopes</summary><div class="source-menu" id="actorScopeMenu"></div><div class="source-actions"><button type="button" data-select-all="actorScope">Select all</button><button type="button" data-clear-all="actorScope">Clear all</button></div></details></div>
<span class="small" title="A connection requires both names within 500 characters of the same data-centre mention.">ⓘ</span>
<div class="filter-label">Actor type<details class="multi-filter" id="actorKindFilter"><summary id="actorKindSummary">All actor types</summary><div class="source-menu" id="actorKindMenu"></div><div class="source-actions"><button type="button" data-select-all="actorKind">Select all</button><button type="button" data-clear-all="actorKind">Clear all</button></div></details></div>
<div class="filter-label">Network size<details class="multi-filter" id="actorTopFilter"><summary id="actorTopSummary">All sizes</summary><div class="source-menu" id="actorTopMenu"></div><div class="source-actions"><button type="button" data-select-all="actorTop">Select all</button><button type="button" data-clear-all="actorTop">Clear all</button></div></details></div>
<div class="filter-label">Minimum shared articles<details class="multi-filter" id="actorMinFilter"><summary id="actorMinSummary">All thresholds</summary><div class="source-menu" id="actorMinMenu"></div><div class="source-actions"><button type="button" data-select-all="actorMin">Select all</button><button type="button" data-clear-all="actorMin">Clear all</button></div></details></div>
<label class="check-label"><input id="actorCandidates" type="checkbox">Include unreviewed NER candidates</label>
</div>
<p class="small" id="actorSummary" aria-live="polite"></p>
<div class="actor-layout">
<div class="card"><h3>Actors by article count</h3><label class="small" for="actorFind">Find an actor (list only)</label><input id="actorFind" type="search" placeholder="Macron, EirGrid, Microsoft…" style="width:100%;padding:9px;margin:8px 0"><div id="actorRanking" class="actor-ranking"></div><p class="small" id="actorListNote"></p></div>
<div class="card"><div class="network-tools"><button id="actorZoomIn" aria-label="Zoom in network">+</button><button id="actorZoomOut" aria-label="Zoom out network">−</button><button id="actorResetView">Reset view</button></div><svg id="actorNetwork" viewBox="0 0 900 570" role="group" aria-label="Actor co-mention network"></svg><div class="actor-legend" id="actorLegend"></div><p class="small" id="actorGraphNote"></p><details><summary>Strongest connections — click for evidence</summary><div id="actorEdges"></div></details></div>
</div>
<div class="card actor-detail" id="actorDetail" aria-live="polite"></div>
</section>

<div class="results-head"><h2 id="resultTitle">Articles (796)</h2><select id="sort" aria-label="Sort articles"><option value="mentions">Most data-centre mentions</option><option value="newest">Newest first</option><option value="oldest">Oldest first</option></select></div>
<div id="results">__INITIAL_RESULTS__</div><button id="more" class="hide">Show more</button>
<details class="page-help"><summary>Corpus note</summary><footer>Article IDs refer to original article order in the FORSEE IRaMuTeQ files. Dictionary matches and proximity are aids for reading, not coded frames.</footer></details></main>
<div id="articleModal" class="modal hide" role="dialog" aria-modal="true" aria-label="Full article"><div class="modal-panel"><div class="modal-head"><div><div class="small" id="modalMeta"></div><h2 id="modalTitle"></h2></div><button id="closeModal" class="modal-close" aria-label="Close article">Close</button></div><div class="modal-controls" id="modalControls"></div><div class="modal-text" id="modalText"></div></div></div>
<script id="dataset" type="application/json">__DATA__</script><script id="fullArticles" type="application/json">__FULL_ARTICLES__</script><script id="searchIndex" type="application/json">__SEARCH_INDEX__</script>
<script id="themeDictionary" type="application/json">__THEME_DICTIONARY__</script><script id="actorData" type="application/json">__ACTOR_DATA__</script>
<script>
const all=JSON.parse(document.getElementById('dataset').textContent), full=JSON.parse(document.getElementById('fullArticles').textContent), searchIndex=JSON.parse(document.getElementById('searchIndex').textContent);
const ids=['searchMode','query','sort'];const el=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)]));let limit=30;
const outletNames={la_croix:'La Croix',le_monde:'Le Monde',le_figaro:'Le Figaro',les_echos:'Les Échos',aujourdhui_en_france:"Aujourd’hui en France",libération:'Libération',lhumanité:"L’Humanité",TheIrishTimes:'The Irish Times',IrishIndependent:'Irish Independent',IrishDailyMail:'Irish Daily Mail',irishmirrorie:'Irish Mirror'};
const displaySource=s=>outletNames[s]||s;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const selections={country:new Set(['France','Ireland']),language:new Set(all.map(r=>r.language||'Unspecified')),year:new Set(['2022','2023','2024','2025']),source:new Set(all.map(r=>r.source)),theme:new Set(),actorScope:new Set(['near']),actorKind:new Set(),actorTop:new Set(['25']),actorMin:new Set(['2'])};
const multiDefs={country:{values:['France','Ireland'],labels:['France','Ireland'],all:'Both countries',none:'No countries selected'},language:{values:[...new Set(all.map(r=>r.language||'Unspecified'))].sort(),all:'All languages',none:'No languages selected'},year:{values:['2022','2023','2024','2025'],all:'All years',none:'No years selected'},source:{all:'All newspapers',none:'No newspapers selected',format:(n,total)=>`${n} newspaper${n===1?'':'s'} selected`},theme:{values:[['ecology_near','Ecology'],['energy_near','Energy / grid'],['sovereignty_near','Sovereignty'],['ai_near','AI'],['ecology_sovereignty','Ecology + sovereignty'],['neither','Neither ecology nor sovereignty']].map(x=>x[0]),labels:[['ecology_near','Ecology'],['energy_near','Energy / grid'],['sovereignty_near','Sovereignty'],['ai_near','AI'],['ecology_sovereignty','Ecology + sovereignty'],['neither','Neither ecology nor sovereignty']].map(x=>x[1]),all:'Any theme',none:'No themes selected'},actorScope:{values:['near','all'],labels:['Near a data-centre mention (within 500 characters)','Anywhere in the same article'],all:'Both scopes',none:'No scopes selected'},actorKind:{all:'All actor types',none:'No actor types selected'},actorTop:{values:['15','25','40'],all:'All sizes',none:'No sizes selected'},actorMin:{values:['1','2','3','5','10'],all:'All thresholds',none:'No thresholds selected'}};
function optionsFor(key){if(key==='source')return [...new Set(all.filter(r=>selections.country.has(r.country)&&selections.language.has(r.language||'Unspecified')).map(r=>r.source))].sort();if(key==='actorKind')return [...new Set(Object.values(actorData.actors).map(a=>a.category))].sort();return multiDefs[key].values||[]}
function updateMulti(key,reset=false){const def=multiDefs[key],names=optionsFor(key),menu=document.getElementById(key+'Menu'),summary=document.getElementById(key+'Summary');if(reset)selections[key]=new Set(names);else selections[key]=new Set([...selections[key]].filter(x=>names.includes(x)));const labels=def.labels?Object.fromEntries(def.values.map((v,i)=>[v,def.labels[i]])):{};menu.innerHTML=names.map(v=>`<label><input type="checkbox" value="${esc(v)}" ${selections[key].has(v)?'checked':''}>${esc(labels[v]|| (key==='source'?displaySource(v):v))}</label>`).join('')||'<span class="small">No options available.</span>';summary.textContent=key==='theme'&&!selections.theme.size?def.all:selections[key].size===names.length?def.all:selections[key].size?(def.format?def.format(selections[key].size,names.length):`${selections[key].size} selected`):def.none}
function renderAllMulti(resetDependents=false){updateMulti('country');updateMulti('language');updateMulti('year');updateMulti('source',resetDependents);updateMulti('theme');updateMulti('actorScope');updateMulti('actorKind');updateMulti('actorTop');updateMulti('actorMin')}
function card(label,n,total){return `<div class="card"><strong>${n.toLocaleString()}</strong><span>${label}${total?' · '+(100*n/total).toFixed(1)+'%':''}</span></div>`}
function bar(label,n,max,cls='',outlet=false,total=0){return `<div class="barrow${outlet?' outlet':''}"><span class="label">${esc(label)}</span><div class="track"><div class="fill ${cls}" style="width:${max?100*n/max:0}%"></div></div><span class="value">${n}${outlet&&total?' · '+(100*n/total).toFixed(1)+'%':''}</span></div>`}
function normalizeSearch(s){return String(s).normalize('NFKD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase().replace(/[^\p{L}\p{N}]+/gu,' ').replace(/\s+/g,' ').trim()}
const searchableCache=new Map();
function searchable(r){if(!searchableCache.has(r.id)){const meta=normalizeSearch([r.id,r.date,r.country,r.source,displaySource(r.source)].join(' '));searchableCache.set(r.id,` ${meta} ${searchIndex[r.id]||''} `)}return searchableCache.get(r.id)}
function tokenize(query){const tokens=[];let buffer='',i=0;const flush=()=>{if(buffer.trim())tokens.push({type:'TERM',value:buffer.trim()});buffer=''};while(i<query.length){const c=query[i];if(c==='"'){flush();i++;let value='',closed=false;while(i<query.length){if(query[i]==='"'){closed=true;i++;break}value+=query[i++]}if(!closed)throw Error('Unclosed quotation mark.');if(!value.trim())throw Error('Empty quoted phrase.');tokens.push({type:'TERM',value});continue}if(c==='('||c===')'){flush();tokens.push({type:c});i++;continue}const match=/^(AND|OR|NOT)\b/.exec(query.slice(i));if(match&&(i===0||/[\s()]/.test(query[i-1]))&&(i+match[0].length===query.length||/[\s()]/.test(query[i+match[0].length]))){flush();tokens.push({type:match[0]});i+=match[0].length;continue}buffer+=c;i++}flush();return tokens}
function compileBoolean(query){const tokens=tokenize(query);if(!tokens.length)return()=>true;let pos=0;const peek=()=>tokens[pos]?.type;
function atom(){if(peek()==='NOT'){pos++;const child=atom();return text=>!child(text)}if(peek()==='('){pos++;const child=orExpr();if(peek()!==')')throw Error('Missing closing parenthesis.');pos++;return child}if(peek()==='TERM'){const term=normalizeSearch(tokens[pos++].value);if(!term)throw Error('A search phrase has no searchable letters or numbers.');return text=>text.includes(` ${term} `)}throw Error('Expected a phrase or opening parenthesis.')}
function andExpr(){let left=atom();while(peek()==='AND'){pos++;const previous=left,right=atom();left=text=>previous(text)&&right(text)}return left}
function orExpr(){let left=andExpr();while(peek()==='OR'){pos++;const previous=left,right=andExpr();left=text=>previous(text)||right(text)}return left}
const result=orExpr();if(pos<tokens.length)throw Error(`Unexpected ${tokens[pos].type}. Add AND or OR between phrases.`);return result}
function searchPredicate(){const q=el.query.value.trim();if(!q)return()=>true;if(el.searchMode.value==='simple'){const term=normalizeSearch(q);return term?text=>text.includes(` ${term} `):()=>true}return compileBoolean(q)}
function articleCard(r){const tags=[r.id,r.country,r.date,displaySource(r.source),`${r.dc_mentions} DC mentions`].map(v=>`<span class="tag">${esc(v)}</span>`).join('');const themes=[['ecology_near','Ecology','eco'],['energy_near','Energy','energy'],['sovereignty_near','Sovereignty','sov']].filter(([key])=>r[key]).map(([,name,cls])=>`<span class="tag ${cls}">${name}</span>`).join('');const title=r.opening?`<h3>${esc(r.opening.slice(0,230))}${r.opening.length>230?'…':''}</h3>`:'';return `<article class="result" id="${esc(r.id)}"><div class="tags">${tags}${themes}</div>${title}${full[r.id]?`<button class="read-button" data-id="${esc(r.id)}">Read full article with highlighted matches</button>`:''}</article>`}
function render(){let predicate;const error=document.getElementById('searchError');try{predicate=searchPredicate();error.classList.add('hide');error.textContent=''}catch(e){predicate=()=>false;error.textContent=`Search syntax: ${e.message}`;error.classList.remove('hide')}const hasQuery=!!el.query.value.trim();const themeKeys=[...selections.theme];const a=all.filter(r=>selections.country.has(r.country)&&selections.language.has(r.language||'Unspecified')&&selections.year.has(r.date.slice(0,4))&&selections.source.has(r.source)&&(!themeKeys.length||themeKeys.some(theme=>theme==='ecology_sovereignty'?r.ecology_near&&r.sovereignty_near:theme==='neither'?!r.ecology_near&&!r.sovereignty_near:r[theme]))&&(!hasQuery||predicate(searchable(r))));const n=a.length;
const eco=a.filter(r=>r.ecology_near).length,energy=a.filter(r=>r.energy_near).length,sov=a.filter(r=>r.sovereignty_near).length;document.getElementById('stats').innerHTML=card('matching articles',n)+card('ecology nearby',eco,n)+card('energy / grid nearby',energy,n)+card('sovereignty nearby',sov,n);
const years=['2022','2023','2024','2025'].map(y=>[y,a.filter(r=>r.date.startsWith(y)).length]);document.getElementById('years').innerHTML=years.map(([y,count])=>bar(y,count,Math.max(1,...years.map(x=>x[1])))).join('');document.getElementById('themes').innerHTML=[['Ecology',eco,'ecology'],['Energy',energy,'energy'],['Sovereignty',sov,'sovereignty'],['AI',a.filter(r=>r.ai_near).length,'ai']].map(([name,count,key])=>themeBar(name,count,n,key)).join('');
renderActors(a);
const counts=new Map();a.forEach(r=>counts.set(r.source,(counts.get(r.source)||0)+1));const outlets=[...counts].sort((x,y)=>y[1]-x[1]||x[0].localeCompare(y[0]));document.getElementById('newspapers').innerHTML=outlets.length?outlets.map(([source,count])=>bar(displaySource(source),count,outlets[0][1],'',true,n)).join(''):'<span class="small">No matching articles.</span>';
a.sort((x,y)=>el.sort.value==='newest'?y.date.localeCompare(x.date):el.sort.value==='oldest'?x.date.localeCompare(y.date):y.dc_mentions-x.dc_mentions||y.date.localeCompare(x.date));document.getElementById('resultTitle').textContent=`Articles (${n})`;document.getElementById('results').innerHTML=a.slice(0,limit).map(articleCard).join('');document.getElementById('more').classList.toggle('hide',n<=limit);document.getElementById('more').textContent=`Show ${Math.min(30,n-limit)} more`}
const modal=document.getElementById('articleModal');let lastButton=null;const hitCursor={};
function openArticle(id){const r=all.find(x=>x.id===id),body=full[id];if(!r||!body)return;lastButton=document.activeElement;document.getElementById('modalMeta').textContent=`${r.country} · ${displaySource(r.source)} · ${r.date} · ${r.id}`;document.getElementById('modalTitle').textContent=r.opening.slice(0,170)+(r.opening.length>170?'…':'');document.getElementById('modalText').innerHTML=`<p>${body}</p>`;const labels=[['dc','Data centre'],['ecology','Ecology'],['energy','Energy / grid'],['sovereignty','Sovereignty']];document.getElementById('modalControls').innerHTML=labels.map(([key,label])=>{const n=document.querySelectorAll(`#modalText .hit-${key}`).length;return n?`<button data-hit="${key}">Next ${label.toLowerCase()} match (${n})</button>`:''}).join('');Object.keys(hitCursor).forEach(k=>delete hitCursor[k]);modal.classList.remove('hide');document.body.classList.add('modal-open');document.getElementById('closeModal').focus()}
function closeArticle(){modal.classList.add('hide');document.body.classList.remove('modal-open');document.getElementById('modalText').innerHTML='';if(lastButton)lastButton.focus()}
document.getElementById('results').addEventListener('click',e=>{const b=e.target.closest('button[data-id]');if(b)openArticle(b.dataset.id)});document.getElementById('modalControls').addEventListener('click',e=>{const key=e.target.dataset.hit;if(!key)return;const hits=[...document.querySelectorAll(`#modalText .hit-${key}`)];if(!hits.length)return;hitCursor[key]=((hitCursor[key]??-1)+1)%hits.length;hits[hitCursor[key]].scrollIntoView({block:'center',behavior:'smooth'})});document.getElementById('closeModal').onclick=closeArticle;modal.addEventListener('click',e=>{if(e.target===modal)closeArticle()});document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!modal.classList.contains('hide'))closeArticle()});
__ACTOR_JS__
document.getElementById('profileTabs').addEventListener('click',event=>{const tab=event.target.closest('[data-profile]');if(!tab)return;document.querySelectorAll('#profileTabs [data-profile]').forEach(button=>button.setAttribute('aria-selected',String(button===tab)));document.querySelectorAll('.profile-panel').forEach(panel=>panel.hidden=panel.id!==`panel-${tab.dataset.profile}`)});
ids.forEach(id=>el[id].addEventListener(id==='query'?'input':'change',()=>{limit=30;render()}));for(const key of Object.keys(multiDefs)){document.getElementById(key+'Menu').addEventListener('change',event=>{const input=event.target.closest('input[type="checkbox"]');if(!input)return;if(input.checked)selections[key].add(input.value);else selections[key].delete(input.value);if(key==='country'||key==='language')updateMulti('source',true);updateMulti(key);limit=30;render()})}document.querySelectorAll('[data-select-all]').forEach(button=>button.onclick=()=>{const key=button.dataset.selectAll;selections[key]=new Set(optionsFor(key));updateMulti(key);if(key==='country'||key==='language')updateMulti('source',true);render()});document.querySelectorAll('[data-clear-all]').forEach(button=>button.onclick=()=>{const key=button.dataset.clearAll;selections[key].clear();updateMulti(key);if(key==='country'||key==='language')updateMulti('source',true);render()});document.querySelectorAll('[data-example]').forEach(button=>button.addEventListener('click',()=>{el.searchMode.value='boolean';el.query.value=button.dataset.example;limit=30;render();el.query.focus()}));if(!Object.keys(searchIndex).length){document.getElementById('searchScope').innerHTML='<strong>Public preview: search covers article metadata only.</strong>';document.querySelectorAll('[data-example]').forEach(button=>button.hidden=true)}document.getElementById('more').onclick=()=>{limit+=30;render()};multiDefs.language.values=[...new Set(all.map(r=>r.language||'Unspecified'))].sort();selections.language=new Set(multiDefs.language.values);selections.actorKind=new Set(optionsFor('actorKind'));document.querySelectorAll('details.multi-filter').forEach(details=>details.open=false);updateMulti('country');updateMulti('language');updateMulti('year');updateMulti('source');updateMulti('theme');updateMulti('actorScope');updateMulti('actorKind');updateMulti('actorTop');updateMulti('actorMin');render();
</script></body></html>
